# =============================================================================
# Modèle de configuration — copier en `.env` puis remplir.
# ⚠️  Le fichier `.env` est ignoré par git : AUCUNE clé ne doit être commitée.
#     En CI, ces valeurs proviennent exclusivement des GitHub Secrets.
# =============================================================================

# --- API LLM (offre gratuite Groq : https://console.groq.com) ---
# Si vide, le système bascule automatiquement en mode dégradé hors-ligne
# (génération déterministe locale) : le pipeline ne plante jamais.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Paramètres d'évolution ---
POPULATION_SIZE=5          # Nombre d'agents par génération
ELITE_SIZE=1               # Nombre d'agents conservés tels quels (élitisme)
BASE_MUTATION_RATE=0.30    # Taux de mutation initial [0.0 - 1.0]
MAX_ITEMS_PER_RUN=12       # Nombre max d'items RSS traités par cycle (rate-limit friendly)

# --- Ingestion (respect strict des CGU / robots.txt / rate limits) ---
# Flux RSS publics séparés par des virgules. Uniquement des flux explicitement
# destinés à la syndication.
RSS_FEEDS=https://hnrss.org/frontpage,https://www.lemondeinformatique.fr/flux-rss/thematique/tout-les-articles/rss.xml,https://feeds.arstechnica.com/arstechnica/technology-lab
HTTP_USER_AGENT=AgentEvolutionBot/1.0 (+https://github.com/; contact via GitHub issues)
REQUEST_TIMEOUT=15         # Timeout HTTP en secondes
MIN_DELAY_BETWEEN_REQUESTS=2.0   # Politesse : délai minimal entre 2 requêtes (s)

# --- Affiliation (optionnel, désactivé si vide) ---
# Aucun lien affilié n'est injecté tant que ce champ est vide.
AFFILIATE_TAG=
AFFILIATE_BASE_URL=

# --- Publication ---
PUBLISH_DIR=docs           # Dossier servi par GitHub Pages
PUBLISH_WEBHOOK_URL=       # Optionnel : webhook (Discord/Slack/Zapier) — laisser vide pour désactiver

# --- Divers ---
LOG_LEVEL=INFO
DB_PATH=data/evolution.db
